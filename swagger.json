{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Get all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Books returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields, duplicate id, or unknown authorId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "examples": {
                  "missingFields": {
                    "value": {
                      "message": "id, authorId, title, and publicationDate are required"
                    }
                  },
                  "invalidDate": {
                    "value": {
                      "message": "publicationDate must be a valid date in YYYY-MM-DD format"
                    }
                  },
                  "unknownAuthor": {
                    "value": {
                      "message": "authorId does not match an existing author"
                    }
                  },
                  "duplicateId": {
                    "value": {
                      "message": "A book with that id already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/books/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "description": "The custom book id, such as b1",
          "schema": {
            "type": "string",
            "example": "b1"
          }
        }
      ],
      "get": {
        "summary": "Get one book by id",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Book returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Update a book",
        "description": "The id in the URL identifies the book. An id in the body is ignored, so ids cannot change.",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields, or unknown authorId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "examples": {
                  "missingFields": {
                    "value": {
                      "message": "authorId, title, and publicationDate are required"
                    }
                  },
                  "unknownAuthor": {
                    "value": {
                      "message": "authorId does not match an existing author"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete a book",
        "tags": [
          "Books"
        ],
        "responses": {
          "204": {
            "description": "Book deleted successfully (no response body)"
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Book not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "Authors returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Author"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Create an author",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields, or the id already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "examples": {
                  "missingFields": {
                    "value": {
                      "message": "id, name, and birthYear are required"
                    }
                  },
                  "invalidBirthYear": {
                    "value": {
                      "message": "birthYear must be a whole number between 1 and the current year"
                    }
                  },
                  "duplicateId": {
                    "value": {
                      "message": "An author with that id already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/authors/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "description": "The custom author id, such as a1",
          "schema": {
            "type": "string",
            "example": "a1"
          }
        }
      ],
      "get": {
        "summary": "Get one author by id",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "Author returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "404": {
            "description": "Author not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Author not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Update an author",
        "description": "The id in the URL identifies the author. An id in the body is ignored, so ids cannot change.",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Author updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "name and birthYear are required"
                }
              }
            }
          },
          "404": {
            "description": "Author not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Author not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete an author",
        "description": "An author who still has books cannot be deleted (409). Delete or reassign their books first.",
        "tags": [
          "Authors"
        ],
        "responses": {
          "204": {
            "description": "Author deleted successfully (no response body)"
          },
          "404": {
            "description": "Author not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Author not found"
                }
              }
            }
          },
          "409": {
            "description": "Author still has books",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "Author cannot be deleted while books reference them"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Check that the server is running",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "example": {
                  "message": "Server is running"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Custom book id",
            "example": "b1"
          },
          "authorId": {
            "type": "string",
            "description": "The id of the book's author (references authors.id)",
            "example": "a1"
          },
          "title": {
            "type": "string",
            "example": "Patterns of Light"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date (YYYY-MM-DD)",
            "example": "2021-08-17"
          }
        }
      },
      "BookInput": {
        "type": "object",
        "required": [
          "id",
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Custom book id (must be unique)"
          },
          "authorId": {
            "type": "string",
            "description": "Must match the id of an existing author"
          },
          "title": {
            "type": "string"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date (YYYY-MM-DD)"
          }
        },
        "example": {
          "id": "b4",
          "authorId": "a1",
          "title": "Example Book Title",
          "publicationDate": "2026-01-15"
        }
      },
      "BookUpdate": {
        "type": "object",
        "required": [
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "authorId": {
            "type": "string",
            "description": "Must match the id of an existing author"
          },
          "title": {
            "type": "string"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date (YYYY-MM-DD)"
          }
        },
        "example": {
          "authorId": "a2",
          "title": "Updated Book Title",
          "publicationDate": "2026-02-20"
        }
      },
      "Author": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Custom author id",
            "example": "a1"
          },
          "name": {
            "type": "string",
            "example": "Maya Rivera"
          },
          "birthYear": {
            "type": "integer",
            "example": 1978
          }
        }
      },
      "AuthorInput": {
        "type": "object",
        "required": [
          "id",
          "name",
          "birthYear"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Custom author id (must be unique)"
          },
          "name": {
            "type": "string"
          },
          "birthYear": {
            "type": "integer",
            "description": "Whole number between 1 and the current year"
          }
        },
        "example": {
          "id": "a4",
          "name": "Example Author",
          "birthYear": 1980
        }
      },
      "AuthorUpdate": {
        "type": "object",
        "required": [
          "name",
          "birthYear"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "birthYear": {
            "type": "integer",
            "description": "Whole number between 1 and the current year"
          }
        },
        "example": {
          "name": "Updated Author",
          "birthYear": 1981
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "ServerError": {
        "description": "Unexpected server or database error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Message"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      }
    }
  },
  "tags": []
}